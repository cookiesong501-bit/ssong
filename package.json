{
  "name": "ssong-todo",
  "version": "1.4.5",
  "private": true,
  "description": "일정·회고·연간 및 월간 계획·알람·메모를 담는 쏭 플래너",
  "author": "ssong",
  "main": "main.js",
  "dependencies": {
    "date-holidays": "3.38.0"
  },
  "scripts": {
    "start": "electron .",
    "test": "node test/repeat.test.cjs && node test/ui-repeat.cjs && node test/main-repeat.cjs",
    "dist:win": "electron-builder --win portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "38.8.6",
    "electron-builder": "26.15.3",
    "jsdom": "^30.1.3"
  },
  "build": {
    "appId": "com.ssong.todo",
    "productName": "쏭 플래너",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*"
    ],
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "ssong-planner-portable-${version}.exe"
    }
  }
}